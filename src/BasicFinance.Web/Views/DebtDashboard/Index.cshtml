@using BasicFinance.Web.Models
@model DebtDashboardViewModel
@{
    ViewData["Title"] = "Debt dashboard";
}
<section class="page-heading debt-dashboard-page">
    <div><p class="eyebrow">DEBT MANAGEMENT</p><h1>Debt dashboard</h1>
    <p class="page-description">A consolidated view of outstanding balances, payoff strategy projections, balance history, and debt-free milestones.</p></div>
</section>
<section class="summary-grid" aria-label="Debt overview">
    <article class="summary-card"><span>Accounts with balances</span><strong>@Model.ActiveDebtAccountCount</strong></article>
    <article class="summary-card"><span>Debt-free milestones</span><strong>@Model.PaidOffAccountCount</strong></article>
    <article class="summary-card"><span>Currency groups</span><strong>@Model.CurrencySummaries.Count</strong></article>
</section>
<section class="section-block">
    <div class="section-heading"><h2>Outstanding debt by currency</h2><a asp-controller="AccountManagement" asp-action="Index">Manage debts</a></div>
    <div class="table-card"><div class="table-scroll"><table><thead><tr><th>Currency</th><th>Current balance</th><th>Opening amount recorded</th><th>Net reduction*</th><th>Accounts with debt</th><th>Recorded minimums</th></tr></thead><tbody>
    @foreach(var item in Model.CurrencySummaries){<tr><td>@item.CurrencyCode</td><td>@item.CurrentBalance.ToString("N2")</td><td>@item.OpeningBalance.ToString("N2")</td><td>@item.NetReduction.ToString("N2")</td><td>@item.AccountCount</td><td>@item.MonthlyMinimums.ToString("N2")</td></tr>}
    @if(!Model.CurrencySummaries.Any()){<tr><td colspan="6">No active debt or credit-card accounts found.</td></tr>}
    </tbody></table></div></div>
    <p class="muted">*Net reduction compares current balances with account opening balances or original loan amounts where recorded. It is not a total of payments made. Currencies are kept separate.</p>
</section>
<section class="section-block">
    <div class="section-heading"><h2>Snowball vs. avalanche</h2><a asp-controller="AccountManagement" asp-action="Payoff">Run a custom payoff plan</a></div>
    <p class="muted">These projections use current balances, entered APRs, and entered minimum payments, with no extra payment. Results are estimates and do not include future rate changes, fees, or changing minimum-payment rules.</p>
    <div class="table-card"><div class="table-scroll"><table><thead><tr><th>Currency</th><th>Debt balance</th><th>Snowball payoff</th><th>Avalanche payoff</th><th>Snowball interest</th><th>Avalanche interest</th><th>Interest difference</th></tr></thead><tbody>
    @foreach(var item in Model.StrategyComparisons){<tr><td>@item.CurrencyCode</td><td>@item.CurrentBalance.ToString("N2")</td><td>@(item.SnowballDebtFreeDate?.ToString("MMM yyyy") ?? "Unavailable")</td><td>@(item.AvalancheDebtFreeDate?.ToString("MMM yyyy") ?? "Unavailable")</td><td>@(item.IsComplete ? item.SnowballInterest.ToString("N2") : "—")</td><td>@(item.IsComplete ? item.AvalancheInterest.ToString("N2") : "—")</td><td>@(item.IsComplete ? (item.SnowballInterest - item.AvalancheInterest).ToString("N2") : "—")</td></tr>
    @if(!string.IsNullOrWhiteSpace(item.MissingInputs)){<tr><td colspan="7"><span class="table-subtext">@item.MissingInputs</span></td></tr>}}
    @if(!Model.StrategyComparisons.Any()){<tr><td colspan="7">Add an active debt account to see payoff strategy projections.</td></tr>}
    </tbody></table></div></div>
</section>
<section class="section-block">
    <h2>Debt balance trend charts</h2>
    <p class="muted">Each bar shows the latest recorded snapshot total for that month and currency. Bar lengths are scaled within each currency group; they are not combined across currencies.</p>
    @foreach (var currencyGroup in Model.BalanceTrends.GroupBy(x => x.CurrencyCode).OrderBy(x => x.Key))
    {
        var points = currencyGroup.OrderBy(x => x.Month).ToList();
        var maximum = points.Max(x => x.Balance);
        <div class="table-card">
            <h3>@currencyGroup.Key</h3>
            <div class="table-scroll">
                <table>
                    <thead><tr><th>Month</th><th>Recorded balance</th><th>Relative level</th><th>Accounts</th></tr></thead>
                    <tbody>
                    @foreach (var point in points)
                    {
                        var percent = maximum > 0m ? Math.Round(point.Balance / maximum * 100m, 1) : 0m;
                        <tr>
                            <td>@point.Month.ToString("MMM yyyy")</td>
                            <td>@point.Balance.ToString("N2")</td>
                            <td><progress max="100" value="@percent" aria-label="@($"{point.Month:MMMM yyyy} balance relative to this chart's highest month: {percent}%")"></progress> @percent.ToString("N1")%</td>
                            <td>@point.AccountsWithSnapshots</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (!Model.BalanceTrends.Any())
    {
        <p>No historical snapshots are available to chart yet.</p>
    }
</section>
<section class="section-block">
    <h2>Payoff forecast comparison</h2>
    <p class="muted">Forecasts use each currency's current recorded balances, APRs, and minimum payments. The month bars compare estimated time to debt-free; interest amounts remain separated by currency. These are simulations, not payment instructions.</p>
    @foreach (var forecast in Model.StrategyComparisons.Where(x => x.IsComplete).OrderBy(x => x.CurrencyCode))
    {
        var months = new[] {
            (Name: "Snowball", Date: forecast.SnowballDebtFreeDate, Interest: forecast.SnowballInterest),
            (Name: "Avalanche", Date: forecast.AvalancheDebtFreeDate, Interest: forecast.AvalancheInterest)
        };
        var maxMonths = Math.Max(1, months.Max(x => x.Date.HasValue ? ((x.Date.Value.Year - DateTime.Today.Year) * 12 + x.Date.Value.Month - DateTime.Today.Month) : 1));
        <div class="table-card">
            <h3>@forecast.CurrencyCode forecast</h3>
            <div class="table-scroll">
                <table>
                    <thead><tr><th>Strategy</th><th>Estimated debt-free</th><th>Months remaining</th><th>Relative timeline</th><th>Projected interest</th></tr></thead>
                    <tbody>
                    @foreach (var scenario in months)
                    {
                        var remainingMonths = scenario.Date.HasValue ? Math.Max(0, (scenario.Date.Value.Year - DateTime.Today.Year) * 12 + scenario.Date.Value.Month - DateTime.Today.Month) : 0;
                        var percent = maxMonths > 0 ? Math.Round((decimal)remainingMonths / maxMonths * 100m, 1) : 0m;
                        <tr>
                            <td>@scenario.Name</td>
                            <td>@scenario.Date?.ToString("MMM yyyy")</td>
                            <td>@remainingMonths</td>
                            <td><progress max="100" value="@percent" aria-label="@($"{scenario.Name} timeline relative to the longer strategy: {percent}%")"></progress> @percent.ToString("N1")%</td>
                            <td>@scenario.Interest.ToString("N2") @forecast.CurrencyCode</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (!Model.StrategyComparisons.Any(x => x.IsComplete))
    {
        <p>Complete the missing APR and minimum-payment details to display payoff forecasts.</p>
    }
</section>
<section class="section-block">
    <h2>Balance history trend</h2>
    <p class="muted">Monthly totals use the latest saved balance snapshot for each account in that month. Months without snapshots are not estimated or filled in.</p>
    <div class="table-card"><div class="table-scroll"><table><thead><tr><th>Month</th><th>Currency</th><th>Snapshot balance total</th><th>Accounts represented</th></tr></thead><tbody>
    @foreach(var point in Model.BalanceTrends.OrderByDescending(x => x.Month).ThenBy(x => x.CurrencyCode)){<tr><td>@point.Month.ToString("MMM yyyy")</td><td>@point.CurrencyCode</td><td>@point.Balance.ToString("N2")</td><td>@point.AccountsWithSnapshots</td></tr>}
    @if(!Model.BalanceTrends.Any()){<tr><td colspan="4">No balance snapshots yet. Capture account balances from Debt Management to begin tracking trends.</td></tr>}
    </tbody></table></div></div>
    <p><a asp-controller="AccountManagement" asp-action="Index">Open balance history and capture snapshots</a></p>
</section>
<section class="section-block">
    <div class="section-heading"><h2>Recent debt-free milestones</h2><a asp-controller="DebtGoals" asp-action="Index">View debt-free goals</a></div>
    <div class="table-card"><div class="table-scroll"><table><thead><tr><th>Account</th><th>Currency</th><th>Paid-off date</th><th>Status</th><th>Reopened date</th></tr></thead><tbody>
    @foreach(var item in Model.RecentMilestones){<tr><td>@item.AccountName</td><td>@item.CurrencyCode</td><td>@item.AchievedDate.ToString("MMM d, yyyy")</td><td>@(item.IsReopened ? "Reopened" : "Paid off")</td><td>@(item.ReopenedDate?.ToString("MMM d, yyyy") ?? "—")</td></tr>}
    @if(!Model.RecentMilestones.Any()){<tr><td colspan="5">No debt-free milestones recorded yet.</td></tr>}
    </tbody></table></div></div>
</section>
