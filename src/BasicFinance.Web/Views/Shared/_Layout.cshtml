<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#172b4d" />
    <title>@ViewData["Title"] - BasicFinance</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navigation" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index">BasicFinance</a>
        <div class="navigation-links">
            <a class="navigation-link" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="navigation-link" asp-controller="Accounts" asp-action="Index">Accounts</a>
        </div>
        <span class="navigation-caption">Personal finance workspace</span>
    </nav>
</header>
<main class="page-content">
    @RenderBody()
</main>
<footer class="site-footer">
    <div>BasicFinance <span aria-hidden="true">·</span> Local-first finance workspace</div>
</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
