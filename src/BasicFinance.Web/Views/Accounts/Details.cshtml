@model BasicFinance.Web.Models.Account
@{
    ViewData["Title"] = Model.Name;
}
<section class="page-heading">
    <div><p class="eyebrow">ACCOUNT DETAILS</p><h1>@Model.Name</h1><p class="page-description">@Model.Type · @(Model.Institution ?? "No institution specified")</p></div>
    <a class="button button-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit account</a>
</section>
@if (TempData["SuccessMessage"] is string message)
{
    <div class="notice notice-success" role="status">@message</div>
}
<section class="detail-card">
    <dl class="detail-grid">
        <div><dt>Opening balance</dt><dd>@Model.OpeningBalance.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</dd></div>
        <div><dt>Currency</dt><dd>@Model.CurrencyCode</dd></div>
        <div><dt>Account number</dt><dd>@(Model.AccountNumberLast4 is null ? "Not provided" : $"•••• {Model.AccountNumberLast4}")</dd></div>
        <div><dt>Date opened</dt><dd>@(Model.OpenedOn?.ToString("MMM d, yyyy") ?? "Not provided")</dd></div>
        <div><dt>Status</dt><dd>@Model.Status</dd></div>
        <div><dt>Created</dt><dd>@Model.CreatedUtc.ToString("MMM d, yyyy 'UTC'")</dd></div>
    </dl>
</section>
<div class="detail-actions">
    <a asp-action="Index">Back to accounts</a>
    @if (Model.Status != BasicFinance.Web.Models.AccountStatus.Archived)
    {
        <form asp-action="Archive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Archive this account? Its records will be retained.');">
            <button type="submit" class="button button-danger">Archive account</button>
        </form>
    }
</div>
