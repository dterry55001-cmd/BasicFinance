@model BasicFinance.Web.Models.Account
@using BasicFinance.Web.Models
@{
    ViewData["Title"] = Model.Name;
    var recent = ViewBag.RecentTransactions as IReadOnlyList<FinancialTransaction> ?? [];
    var balance = (decimal)ViewBag.CurrentBalance;
}
<section class="page-heading">
    <div><p class="eyebrow">ACCOUNT DETAILS</p><h1>@Model.Name</h1><p class="page-description">@Model.Type · @(Model.Institution ?? "No institution specified")</p></div>
    <div class="heading-actions"><a class="button button-primary" asp-controller="Transactions" asp-action="Create" asp-route-accountId="@Model.Id">Add transaction</a><a class="button button-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit account</a></div>
</section>
@if (TempData["SuccessMessage"] is string message) { <div class="notice notice-success" role="status">@message</div> }
<section class="detail-card">
    <dl class="detail-grid">
        <div><dt>Current balance</dt><dd class="balance-value">@balance.ToString("N2") @Model.CurrencyCode</dd></div>
        <div><dt>Opening balance</dt><dd>@Model.OpeningBalance.ToString("N2") @Model.CurrencyCode</dd></div>
        @if (Model.RetirementType.HasValue) { <div><dt>Retirement account type</dt><dd>@Model.RetirementType.Value</dd></div> }
        @if (Model.DebtType.HasValue) { <div><dt>Debt account type</dt><dd>@Model.DebtType.Value</dd></div> }
        @if (Model.InterestRatePercent.HasValue) { <div><dt>Interest rate / APY</dt><dd>@Model.InterestRatePercent.Value.ToString("0.###")%</dd></div> }
        @if (Model.CreditLimit.HasValue) { <div><dt>Credit limit</dt><dd>@Model.CreditLimit.Value.ToString("N2") @Model.CurrencyCode</dd></div> }
        @if (Model.MinimumPayment.HasValue) { <div><dt>Minimum payment</dt><dd>@Model.MinimumPayment.Value.ToString("N2") @Model.CurrencyCode</dd></div> }
        @if (Model.PaymentDueDay.HasValue) { <div><dt>Payment due day</dt><dd>@Model.PaymentDueDay.Value</dd></div> }
        @if (Model.OriginalLoanAmount.HasValue) { <div><dt>Original loan amount</dt><dd>@Model.OriginalLoanAmount.Value.ToString("N2") @Model.CurrencyCode</dd></div> }
        @if (Model.LoanTermMonths.HasValue) { <div><dt>Loan term</dt><dd>@Model.LoanTermMonths.Value months</dd></div> }
        @if (Model.MaturityDate.HasValue) { <div><dt>Maturity date</dt><dd>@Model.MaturityDate.Value.ToString("MMM d, yyyy")</dd></div> }
        @if (!string.IsNullOrWhiteSpace(Model.EmployerName)) { <div><dt>Employer</dt><dd>@Model.EmployerName</dd></div> }
        @if (Model.EmployerMatchPercent.HasValue) { <div><dt>Employer match</dt><dd>@Model.EmployerMatchPercent.Value.ToString("0.##")%</dd></div> }
        @if (!string.IsNullOrWhiteSpace(Model.TaxTreatment)) { <div><dt>Tax treatment</dt><dd>@Model.TaxTreatment</dd></div> }
        @if (!string.IsNullOrWhiteSpace(Model.BrokerageRegistrationType)) { <div><dt>Brokerage registration</dt><dd>@Model.BrokerageRegistrationType</dd></div> }
        @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="detail-grid-wide"><dt>Notes</dt><dd>@Model.Notes</dd></div> }
        <div><dt>Currency</dt><dd>@Model.CurrencyCode</dd></div>
        <div><dt>Date opened</dt><dd>@(Model.OpenedOn?.ToString("MMM d, yyyy") ?? "Not provided")</dd></div>
        <div><dt>Status</dt><dd>@Model.Status</dd></div>
    </dl>
</section>
<section class="section-block">
    <div class="section-heading"><h2>Recent activity</h2><a asp-controller="Transactions" asp-action="Index" asp-route-accountId="@Model.Id">View all transactions</a></div>
    @if (recent.Count == 0)
    {
        <div class="empty-state compact"><h2>No activity yet</h2><p>Transactions posted to this account will appear here.</p></div>
    }
    else
    {
        <div class="table-card"><div class="table-scroll"><table>
            <thead><tr><th>Date</th><th>Description</th><th>Type</th><th>Amount</th></tr></thead>
            <tbody>
            @foreach (var transaction in recent)
            {
                var isOut = transaction.Type is TransactionType.Expense or TransactionType.Withdrawal || (transaction.Type == TransactionType.Transfer && transaction.AccountId == Model.Id);
                <tr><td>@transaction.TransactionDate.ToString("MMM d, yyyy")</td><td>@transaction.Description@if (transaction.Type == TransactionType.Transfer) { <div class="table-subtext">@(transaction.AccountId == Model.Id ? $"To {transaction.RelatedAccount?.Name}" : $"From {transaction.Account.Name}")</div> }</td><td>@transaction.Type</td><td class="@(isOut ? "amount-out" : "amount-in")">@(isOut ? "−" : "+")@transaction.Amount.ToString("N2") @transaction.CurrencyCode</td></tr>
            }
            </tbody>
        </table></div></div>
    }
</section>
<div class="detail-actions">
    <a asp-action="Index">Back to accounts</a>
    @if (Model.Status != AccountStatus.Archived)
    {
        <form asp-action="Archive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Archive this account? Its records will be retained.');"><button type="submit" class="button button-danger">Archive account</button></form>
    }
</div>
