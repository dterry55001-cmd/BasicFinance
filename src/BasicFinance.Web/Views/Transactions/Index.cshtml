@model IReadOnlyList<BasicFinance.Web.Models.FinancialTransaction>
@using BasicFinance.Web.Models
@{ ViewData["Title"] = "Transactions"; }
<section class="page-heading"><div><p class="eyebrow">FINANCIAL ACTIVITY</p><h1>Transactions</h1><p class="page-description">Review, search, and manage activity across your accounts.</p></div><a class="button button-primary" asp-action="Create">Add transaction</a></section>
@if (TempData["SuccessMessage"] is string message) { <div class="notice notice-success" role="status">@message</div> }
<form method="get" asp-action="Index" class="filter-card">
    <div class="filter-grid">
        <div class="form-field"><label for="accountId">Account</label><select id="accountId" name="accountId" asp-items="ViewBag.Accounts"><option value="">All accounts</option></select></div>
        <div class="form-field"><label for="from">From</label><input id="from" type="date" name="from" value="@ViewData["From"]" /></div>
        <div class="form-field"><label for="to">To</label><input id="to" type="date" name="to" value="@ViewData["To"]" /></div>
        <div class="form-field"><label for="search">Search</label><input id="search" name="search" value="@ViewData["Search"]" placeholder="Description, category, reference, symbol, CUSIP" /></div>
    </div>
    <div class="form-actions"><button class="button button-primary" type="submit">Apply filters</button><a class="button button-secondary" asp-action="Index">Clear</a></div>
</form>
<div class="toolbar"><span class="muted">@Model.Count transaction(s)</span></div>
@if (Model.Count == 0)
{
    <section class="empty-state"><h2>No transactions found</h2><p>Add a transaction or adjust your filters. Account balances will update automatically from the ledger.</p><a class="button button-primary" asp-action="Create">Add transaction</a></section>
}
else
{
    <div class="table-card"><div class="table-scroll"><table>
        <thead><tr><th>Date</th><th>Description</th><th>Account</th><th>Type</th><th>Category</th><th>Amount</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var transaction in Model)
        {
            var isOutflow = transaction.Type is TransactionType.Expense or TransactionType.Withdrawal or TransactionType.Transfer;
            <tr>
                <td>@transaction.TransactionDate.ToString("MMM d, yyyy")</td>
                <td><strong>@transaction.Description</strong>@if (transaction.FundName is not null) { <div class="table-subtext">@transaction.FundName · @(transaction.UnitCount?.ToString("N6") ?? "Units n/a") units</div> }@if (transaction.Symbol is not null || transaction.Cusip is not null) { <div class="table-subtext">@(transaction.Symbol ?? "No symbol") · CUSIP @(transaction.Cusip ?? "—")</div> }@if (transaction.Activity is not null) { <div class="table-subtext">@transaction.Activity · @(transaction.Quantity?.ToString("N6") ?? "—") units @if (transaction.Price.HasValue) { <text>at @transaction.Price.Value.ToString("N4")</text> }</div> }@if (transaction.Type == TransactionType.Transfer && transaction.RelatedAccount is not null) { <div class="table-subtext">To @transaction.RelatedAccount.Name</div> }</td>
                <td>@transaction.Account.Name</td><td>@transaction.Type</td><td>@(transaction.Category ?? "—")</td>
                <td class="@(isOutflow ? "amount-out" : "amount-in")">@(isOutflow ? "−" : "+")@transaction.Amount.ToString("N2") @transaction.CurrencyCode</td>
                <td><div class="table-actions"><a asp-action="Edit" asp-route-id="@transaction.Id">Edit</a><form asp-action="Delete" asp-route-id="@transaction.Id" method="post" onsubmit="return confirm('Delete this transaction? The account balance will be recalculated.');"><button type="submit" class="text-button">Delete</button></form></div></td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
