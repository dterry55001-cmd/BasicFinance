@using BasicFinance.Web.Models
@model DebtPayoffInputModel
@{
    ViewData["Title"] = "Debt payoff planner";
    var plans = ViewBag.PayoffPlans as IReadOnlyList<DebtPayoffPlan>;
}
<section class="page-heading"><div><p class="eyebrow">DEBT PLANNING</p><h1>Debt payoff planner</h1><p class="page-description">Compare the debt snowball and avalanche methods using current account balances, APRs, and minimum payments.</p></div></section>
<form asp-action="Payoff" method="post" class="form-card">
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-field"><label asp-for="CurrencyCode"></label><select asp-for="CurrencyCode" asp-items="(SelectList)ViewBag.DebtCurrencies"></select><span asp-validation-for="CurrencyCode" class="field-error"></span></div>
    <div class="form-field"><label asp-for="ExtraMonthlyPayment"></label><input asp-for="ExtraMonthlyPayment" type="number" min="0" step="0.01" /><span asp-validation-for="ExtraMonthlyPayment" class="field-error"></span><small>This amount is added to the sum of estimated monthly minimums.</small></div>
        <div class="form-field"><label asp-for="CustomMonthlyBudget"></label><input asp-for="CustomMonthlyBudget" type="number" min="0" step="0.01" /><span asp-validation-for="CustomMonthlyBudget" class="field-error"></span><small>Optional total monthly amount, including minimum payments. Must be at least the combined estimated minimums.</small></div>
    <div class="form-actions"><button class="button button-primary" type="submit">Compare payoff strategies</button></div>
</form>
@if (ViewBag.EstimatedMinimums is true) { <div class="notice" role="note">One or more debts have no minimum payment saved. The planner estimates a 1% balance minimum (at least $1) for those accounts. Update account details for a more accurate plan.</div> }
@if (plans is not null)
{
    <section class="section-block">
        <h2>Strategy comparison</h2>
        <p class="page-description">All strategies use the same fixed monthly budget within each comparison. Payments freed when a debt is paid off roll into the remaining debts.</p>
        <div class="summary-grid">
        @foreach (var plan in plans)
        {
            <div class="summary-card">
                <span>@plan.Strategy</span>
                <strong>@(plan.ReachedDebtFree ? plan.DebtFreeDate.ToString("MMM yyyy") : "Not paid off within 100 years")</strong>
                <span>@plan.MonthsToPayoff months · @plan.TotalInterest.ToString("N2") @Model.CurrencyCode interest</span>
                <span>@plan.TotalPaid.ToString("N2") @Model.CurrencyCode total paid</span>
            </div>
        }
        </div>
    </section>
    @if (plans.Count >= 3)
    {
        var snowball = plans.Single(x => x.Strategy == "Snowball");
        var avalanche = plans.Single(x => x.Strategy == "Avalanche");
        <section class="section-block"><h2>Debt-by-debt payoff estimates</h2><div class="table-card"><div class="table-scroll"><table><thead><tr><th>Debt</th><th>Snowball payoff</th><th>Snowball interest</th><th>Avalanche payoff</th><th>Avalanche interest</th></tr></thead><tbody>
        @foreach (var item in snowball.Debts)
        {
            var other = avalanche.Debts.First(x => x.AccountId == item.AccountId);
            <tr><td>@item.AccountName</td><td>@(snowball.ReachedDebtFree || item.MonthsToPayoff < 1200 ? item.PayoffDate.ToString("MMM yyyy") : "Beyond horizon")</td><td>@item.InterestPaid.ToString("N2") @Model.CurrencyCode</td><td>@(avalanche.ReachedDebtFree || other.MonthsToPayoff < 1200 ? other.PayoffDate.ToString("MMM yyyy") : "Beyond horizon")</td><td>@other.InterestPaid.ToString("N2") @Model.CurrencyCode</td></tr>
        }
        </tbody></table></div></div></section>
    }
}
