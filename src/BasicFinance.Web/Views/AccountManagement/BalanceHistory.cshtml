@using BasicFinance.Web.Models
@{
    var account = (Account)ViewBag.Account;
    var snapshots = (IReadOnlyList<AccountBalanceSnapshot>)ViewBag.Snapshots;
    ViewData["Title"] = "Balance history";
}
<section class="page-heading"><div><p class="eyebrow">ACCOUNT HISTORY</p><h1>@account.Name balance history</h1><p class="page-description">Save dated snapshots to preserve balances as they change over time.</p></div></section>
<div class="summary-grid"><div class="summary-card"><span>Current calculated balance</span><strong>@(((decimal)ViewBag.CurrentBalance).ToString("N2")) @account.CurrencyCode</strong></div><div class="summary-card"><span>Saved snapshots</span><strong>@snapshots.Count</strong></div></div>
<form asp-action="CaptureBalance" method="post" class="form-card"><input type="hidden" name="accountId" value="@account.Id" /><div class="form-field"><label for="snapshotDate">Snapshot date</label><input id="snapshotDate" name="snapshotDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><p class="muted">The current calculated balance will be saved for the selected date. Only one snapshot per account per date is allowed.</p><button class="button button-primary" type="submit">Capture current balance</button></form>
<section class="section-block"><h2>Historical balances</h2><div class="table-card"><div class="table-scroll"><table><thead><tr><th>Date</th><th>Balance</th><th>Saved</th></tr></thead><tbody>@foreach (var item in snapshots) { <tr><td>@item.SnapshotDate.ToString("MMM d, yyyy")</td><td>@item.Balance.ToString("N2") @account.CurrencyCode</td><td>@item.CreatedUtc.ToLocalTime().ToString("g")</td></tr> }</tbody></table></div></div></section>
