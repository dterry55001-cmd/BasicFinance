@using BasicFinance.Web.Models
@model LoanAmortizationInput
@{
    ViewData["Title"] = "Loan amortization";
    var result = ViewBag.Result as LoanAmortizationResult;
}
<section class="page-heading"><div><p class="eyebrow">LOAN PLANNING</p><h1>Loan amortization</h1><p class="page-description">Calculate a monthly principal and interest schedule, including the adjusted final payment.</p></div></section>
<form asp-action="Amortization" method="post" class="form-card">
<div asp-validation-summary="All" class="validation-summary"></div>
<div class="form-grid">
<div class="form-field"><label asp-for="AccountId">Debt account (optional)</label><select asp-for="AccountId" asp-items="(SelectList)ViewBag.DebtAccounts"><option value="0">Enter loan details manually</option></select></div>
<div class="form-field"><label asp-for="Principal"></label><input asp-for="Principal" type="number" min="0.01" step="0.01" /></div>
<div class="form-field"><label asp-for="AnnualRatePercent">Annual interest rate (%)</label><input asp-for="AnnualRatePercent" type="number" min="0" max="100" step="0.001" /></div>
<div class="form-field"><label asp-for="TermMonths">Term (months)</label><input asp-for="TermMonths" type="number" min="1" max="600" /></div>
<div class="form-field"><label asp-for="FirstPaymentDate"></label><input asp-for="FirstPaymentDate" type="date" /></div>
</div><div class="form-actions"><button class="button button-primary" type="submit">Calculate schedule</button></div>
</form>
@if (result is not null)
{
<div class="summary-grid"><div class="summary-card"><span>Monthly payment</span><strong>@result.RegularPayment.ToString("C")</strong></div><div class="summary-card"><span>Total interest</span><strong>@result.TotalInterest.ToString("C")</strong></div><div class="summary-card"><span>Total paid</span><strong>@result.TotalPaid.ToString("C")</strong></div></div>
<div class="table-card"><div class="table-scroll"><table><thead><tr><th>Payment</th><th>Date</th><th>Payment</th><th>Principal</th><th>Interest</th><th>Remaining balance</th></tr></thead><tbody>
@foreach (var row in result.Payments) { <tr><td>@row.PaymentNumber</td><td>@row.PaymentDate.ToString("MMM yyyy")</td><td>@row.Payment.ToString("C")</td><td>@row.Principal.ToString("C")</td><td>@row.Interest.ToString("C")</td><td>@row.RemainingBalance.ToString("C")</td></tr> }
</tbody></table></div></div>
}
