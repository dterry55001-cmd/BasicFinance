@model IReadOnlyList<BasicFinance.Web.Models.TransactionCategory>
@using BasicFinance.Web.Models
@{ ViewData["Title"] = "Transaction Categories"; var usage = ViewBag.Usage as Dictionary<int, int> ?? new Dictionary<int, int>(); }
<section class="page-heading"><div><p class="eyebrow">TRANSACTION LEDGER</p><h1>Transaction Categories</h1><p class="page-description">Organize income, expenses, and transfers for consistent financial reporting.</p></div><a class="button button-primary" asp-action="Create">Add category</a></section>
@if (TempData["SuccessMessage"] is string message) { <div class="notice notice-success" role="status">@message</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="notice notice-error" role="alert">@error</div> }
<div class="table-card"><div class="table-scroll"><table>
<thead><tr><th>Category</th><th>Type</th><th>Description</th><th>Transactions</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var category in Model)
{
    <tr>
        <td><strong>@(category.ParentCategoryId.HasValue ? "↳ " : "")@category.Name</strong>@if (category.IsSystem) { <div class="table-subtext">Default category</div> }</td>
        <td>@category.Type</td><td>@(category.Description ?? "—")</td><td>@(usage.TryGetValue(category.Id, out var count) ? count : 0)</td>
        <td>@(category.IsActive ? "Active" : "Inactive")</td>
        <td><div class="table-actions"><a asp-action="Edit" asp-route-id="@category.Id">Edit</a>
        @if (category.IsActive) { <form asp-action="Deactivate" asp-route-id="@category.Id" method="post"><button type="submit" class="text-button">Deactivate</button></form> }
        else { <form asp-action="Reactivate" asp-route-id="@category.Id" method="post"><button type="submit" class="text-button">Reactivate</button></form> }</div></td>
    </tr>
}
</tbody></table></div></div>
<p class="page-description">Categories used by existing transactions cannot be deleted. Deactivate them to keep historical records intact.</p>
