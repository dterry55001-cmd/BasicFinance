@model BasicFinance.Web.Models.TransactionCategoryInputModel
@{ ViewData["Title"] = "Add Category"; }
<section class="page-heading"><div><p class="eyebrow">CATEGORY MANAGEMENT</p><h1>Add category</h1><p class="page-description">Create an income, expense, or transfer category.</p></div></section>
<form asp-action="Create" method="post" class="form-card">
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
<div class="form-field"><label asp-for="Name"></label><input asp-for="Name"/><span asp-validation-for="Name" class="field-error"></span></div>
<div class="form-field"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<BasicFinance.Web.Models.TransactionCategoryType>()"></select><span asp-validation-for="Type" class="field-error"></span></div>
<div class="form-field"><label asp-for="ParentCategoryId"></label><select asp-for="ParentCategoryId" asp-items="ViewBag.ParentCategories"><option value="">Top-level category</option></select><span asp-validation-for="ParentCategoryId" class="field-error"></span></div>
<div class="form-field"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number"/><span asp-validation-for="DisplayOrder" class="field-error"></span></div>
<div class="form-field"><label asp-for="Description"></label><input asp-for="Description"/><span asp-validation-for="Description" class="field-error"></span></div>
</div><div class="form-actions"><button class="button button-primary" type="submit">Save category</button><a class="button button-secondary" asp-action="Index">Cancel</a></div>
</form>
