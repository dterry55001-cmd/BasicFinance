@model IReadOnlyList<BasicFinance.Web.Models.DebtNotification>
@{
    ViewData["Title"] = "Debt notifications";
}
<section class="page-heading debt-notifications-page">
    <div>
        <p class="eyebrow">DEBT MANAGEMENT</p>
        <h1>Notifications</h1>
        <p class="page-description">Persistent utilization alerts, payment due-date risks, rising balances, high-interest debt, DTI deterioration, cash-flow stress, credit-limit changes, and debt-goal progress.</p>
    </div>
</section>
<div class="alert alert-info" role="note">
    Notifications are saved in BasicFinance when this page is opened. New alerts are deduplicated; you can mark individual alerts or all alerts as read. Risk indicators use recorded account data and payment schedules; they do not establish that a payment was actually missed or predict lender action.
    Generated: @(((DateTime)ViewBag.GeneratedAt).ToString("MMM d, yyyy h:mm tt"))
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Notifications (@ViewBag.UnreadCount unread)</h2>
    @if (ViewBag.UnreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary" type="submit">Mark all read</button>
        </form>
    }
</div>
<section class="section-block">
    @if (!Model.Any())
    {
        <div class="form-card"><p>No debt or credit alerts currently require attention.</p></div>
    }
    else
    {
        <div class="table-card">
            <div class="table-scroll">
                <table>
                    <thead><tr><th>Status</th><th>Level</th><th>Category</th><th>Alert</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.IsRead ? "Read" : "Unread")</td>
                            <td><strong>@item.Level</strong></td>
                            <td>@item.Category</td>
                            <td>@item.Message</td>
                            <td>@item.EventDate.ToString("MMM d, yyyy")</td>
                            <td>
                                @if (!item.IsRead)
                                {
                                    <form asp-action="MarkRead" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Mark read</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
