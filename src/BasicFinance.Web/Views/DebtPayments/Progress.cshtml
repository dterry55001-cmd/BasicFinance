@using BasicFinance.Web.Models
@{
    ViewData["Title"] = "Debt payoff progress";
    var rows = (IReadOnlyList<DebtProgressRow>)ViewBag.Rows;
    var snapshots = (IReadOnlyList<AccountBalanceSnapshot>)ViewBag.Snapshots;
}
<section class="page-heading debt-payment-progress"><div><p class="eyebrow">DEBT PLANNING</p><h1>Debt payoff progress</h1><p class="page-description">Compare starting and current balances, estimated principal reduction, recorded principal payments, and captured balance history.</p></div></section>
<div class="quick-links"><a class="button button-secondary" asp-action="Index">Payment calendar</a><a class="button button-secondary" asp-controller="AccountManagement" asp-action="Index">Debt management</a></div>
<section class="section-block"><h2>Progress by account</h2><div class="table-card"><div class="table-scroll"><table><thead><tr><th>Account</th><th>Starting balance</th><th>Current balance</th><th>Balance reduced</th><th>Principal recorded</th><th>Progress</th><th></th></tr></thead><tbody>
@foreach (var row in rows)
{
    <tr><td>@row.AccountName<div class="table-subtext">@row.CurrencyCode</div></td><td>@row.OriginalBalance.ToString("N2")</td><td>@row.CurrentBalance.ToString("N2")</td><td>@row.PrincipalReduced.ToString("N2")</td><td>@row.PrincipalRecorded.ToString("N2")</td><td><strong>@row.PercentPaid.ToString("0.0")%</strong><div style="height:8px;background:var(--surface-muted,#e5e7eb);border-radius:8px;overflow:hidden"><div style="height:8px;width:@row.PercentPaid.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)% ;background:#16856b"></div></div></td><td><a asp-controller="AccountManagement" asp-action="BalanceHistory" asp-route-accountId="@row.AccountId">History</a> · <a asp-action="Schedule" asp-route-accountId="@row.AccountId">Schedule payment</a></td></tr>
}
@if (!rows.Any()) { <tr><td colspan="7">No active debt or credit-card accounts found.</td></tr> }
</tbody></table></div></div></section>
<section class="section-block"><h2>Captured balance history</h2><p class="page-description">Historical snapshots are preserved from the account balance history feature.</p><div class="table-card"><div class="table-scroll"><table><thead><tr><th>Date</th><th>Account</th><th>Balance</th></tr></thead><tbody>
@foreach (var snapshot in snapshots)
{
    <tr><td>@snapshot.SnapshotDate.ToString("MMM d, yyyy")</td><td>@snapshot.Account.Name</td><td>@snapshot.Balance.ToString("N2") @snapshot.Account.CurrencyCode</td></tr>
}
@if (!snapshots.Any()) { <tr><td colspan="3">No balance snapshots captured yet.</td></tr> }
</tbody></table></div></div></section>
