@model BasicFinance.Web.Controllers.BudgetIndexViewModel
@{
    ViewData["Title"] = "Budget Management";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
}
<section class="page-heading">
    <div><p class="eyebrow">FINANCIAL PLANNING</p><h1>Budget Management</h1><p class="page-description">Plan monthly spending and compare it with posted expense transactions.</p></div>
</section>
@if (TempData["SuccessMessage"] is string message) { <div class="notice notice-success" role="status">@message</div> }
<form method="get" asp-action="Index" class="filter-bar">
    <label>Year <input type="number" name="year" min="2000" max="2200" value="@Model.Year" /></label>
    <label>Month <select name="month">@for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option> }</select></label>
    <button class="button button-secondary" type="submit">View period</button>
</form>
<div class="summary-grid">
    <article class="summary-card"><span>Total planned</span><strong>@Model.TotalPlanned.ToString("C")</strong><small>@monthName</small></article>
    <article class="summary-card"><span>Actual spending</span><strong>@Model.TotalActual.ToString("C")</strong><small>Posted expense transactions</small></article>
    <article class="summary-card"><span>Remaining budget</span><strong>@((Model.TotalPlanned - Model.TotalActual).ToString("C"))</strong><small>@(Model.TotalActual > Model.TotalPlanned ? "Over budget" : "Available")</small></article>
</div>
<section class="table-card" aria-labelledby="budget-alert-heading">
    <div class="section-heading"><div><h2 id="budget-alert-heading">Spending alerts</h2><p>Alerts are generated when actual spending reaches 50%, 75%, 90%, or 100% of a category budget.</p></div>
        @if (Model.Alerts.Any(x => !x.IsRead)) { <form asp-action="MarkAllAlertsRead" method="post">@Html.AntiForgeryToken()<input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" /><button class="button button-secondary" type="submit">Mark all read</button></form> }
        <form asp-action="UpdateAlertSettings" method="post" class="inline-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" />
            <input type="hidden" name="isEnabled" value="false" />
            <label><input type="checkbox" name="isEnabled" value="true" checked="@Model.AlertsEnabled" /> Enable alerts</label>
            <button class="button button-secondary" type="submit">Save setting</button>
        </form>
    </div>
    @if (Model.Alerts.Count == 0)
    {
        <p class="empty-state">No spending threshold alerts for this period.</p>
    }
    else
    {
        <div class="table-scroll"><table>
            <thead><tr><th>Alert</th><th>Threshold</th><th>Actual spending when reached</th><th>Date</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var alert in Model.Alerts)
            {
                <tr>
                    <td><strong>@alert.Category.Name</strong><div>@alert.Message</div></td>
                    <td>@alert.ThresholdPercent%</td>
                    <td>@alert.ActualAmount.ToString("C")</td>
                    <td>@alert.CreatedUtc.ToLocalTime().ToString("g")</td>
                    <td>@(alert.IsRead ? "Read" : "New")</td>
                    <td>@if (!alert.IsRead) { <form asp-action="MarkAlertRead" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@alert.Id" /><input type="hidden" name="year" value="@Model.Year" /><input type="hidden" name="month" value="@Model.Month" /><button class="button button-secondary" type="submit">Mark read</button></form> }</td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Year" value="@Model.Year" /><input type="hidden" name="Month" value="@Model.Month" />
    <div class="table-card">
        <div class="table-scroll"><table>
            <thead><tr><th>Expense category</th><th>Planned</th><th>Actual</th><th>Remaining</th><th>Usage</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Lines.Count; i++)
            {
                var line = Model.Lines[i];
                var percent = line.PlannedAmount > 0 ? line.ActualAmount / line.PlannedAmount * 100m : 0m;
                <tr>
                    <td><strong>@line.CategoryName</strong><input type="hidden" name="Lines[@i].CategoryId" value="@line.CategoryId" /></td>
                    <td><input type="number" name="Lines[@i].PlannedAmount" min="0" max="999999999999" step="0.01" value="@line.PlannedAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" aria-label="Planned amount for @line.CategoryName" /></td>
                    <td>@line.ActualAmount.ToString("C")</td>
                    <td class="@(line.Remaining < 0 ? "text-danger" : "")">@line.Remaining.ToString("C")</td>
                    <td>@(line.PlannedAmount > 0 ? percent.ToString("0") + "%" : "—")</td>
                </tr>
            }
            </tbody>
        </table></div>
        @if (Model.Lines.Count == 0) { <p class="empty-state">Create active expense categories to begin setting budgets.</p> }
    </div>
    <div class="form-actions"><button class="button button-primary" type="submit">Save budget</button></div>
</form>
