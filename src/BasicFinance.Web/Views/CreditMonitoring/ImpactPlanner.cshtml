@using BasicFinance.Web.Models
@model CreditScoreImpactInput
@{
    ViewData["Title"] = "Credit impact planner";
    var accounts = (IReadOnlyList<Account>)(ViewBag.ImpactAccounts ?? new List<Account>());
    var result = ViewBag.Result as CreditScoreImpactResult;
}
<section class="page-heading"><div><p class="eyebrow">CREDIT HEALTH · PHASE 4</p><h1>Credit impact planner</h1><p class="page-description">Explore how hypothetical revolving-balance payments and credit-limit changes affect reported utilization. This tool does not calculate or predict a credit score.</p></div></section>
@if (accounts.Count == 0)
{
    <p>No active revolving-credit accounts are available. Add a credit-card or revolving line-of-credit account with a credit limit to use this planner.</p>
}
else
{
    <form asp-action="ImpactPlanner" method="post" class="form-card">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="AccountId"></label><select asp-for="AccountId" required><option value="">Choose account</option>@foreach(var account in accounts){<option value="@account.Id">@account.Name — @account.CurrencyCode</option>}</select><span asp-validation-for="AccountId" class="field-error"></span></div>
            <div class="form-field"><label asp-for="BalanceReduction"></label><input asp-for="BalanceReduction" type="number" min="0" step="0.01" /><span asp-validation-for="BalanceReduction" class="field-error"></span><small>Simulated payment applied only to the selected account.</small></div>
            <div class="form-field"><label asp-for="CreditLimitChange"></label><input asp-for="CreditLimitChange" type="number" step="0.01" /><span asp-validation-for="CreditLimitChange" class="field-error"></span><small>Enter a positive number for an increase or negative number for a decrease.</small></div>
        </div>
        <button class="button button-primary" type="submit">Compare credit utilization</button>
    </form>
}
@if (result is not null)
{
    <section class="section-block"><h2>Overall revolving utilization</h2><div class="summary-grid">
        <article class="summary-card"><span>Current utilization</span><strong>@result.CurrentUtilizationPercent.ToString("0.0")%</strong><span>@result.CurrentTotalBalance.ToString("N2") / @result.CurrentTotalLimit.ToString("N2")</span></article>
        <article class="summary-card"><span>Projected utilization</span><strong>@result.ProjectedUtilizationPercent.ToString("0.0")%</strong><span>@result.ProjectedTotalBalance.ToString("N2") / @result.ProjectedTotalLimit.ToString("N2")</span></article>
        <article class="summary-card"><span>Change</span><strong>@(result.UtilizationChangePercentagePoints > 0 ? "+" : "")@result.UtilizationChangePercentagePoints.ToString("0.0") percentage points</strong><span>@result.UtilizationIndicator</span></article>
        <article class="summary-card"><span>Inquiries recorded in last 12 months</span><strong>@result.HardInquiriesLastTwelveMonths hard / @result.SoftInquiriesLastTwelveMonths soft</strong><span>Based on manually entered inquiry history</span></article>
    </div></section>
    <section class="section-block"><h2>Account-level comparison</h2><div class="table-card"><div class="table-scroll"><table><thead><tr><th>Account</th><th>Current balance</th><th>Current limit</th><th>Current utilization</th><th>Projected balance</th><th>Projected limit</th><th>Projected utilization</th></tr></thead><tbody>
    @foreach(var account in result.Accounts){<tr><td>@account.Name</td><td>@account.Balance.ToString("N2")</td><td>@account.CreditLimit.ToString("N2")</td><td>@account.UtilizationPercent.ToString("0.0")%</td><td>@account.ProjectedBalance.ToString("N2")</td><td>@account.ProjectedLimit.ToString("N2")</td><td>@account.ProjectedUtilizationPercent.ToString("0.0")%</td></tr>}
    </tbody></table></div></div></section>
    <p class="page-description">Utilization calculations are arithmetic estimates from your current ledger balances and recorded limits. Credit scoring models can consider additional factors, different account groupings, bureau-specific reported balances, and scoring-model versions. Inquiry counts do not translate directly into points. No score-point change, approval outcome, or bureau update is predicted.</p>
}
