@model BasicFinance.Web.Models.StatementImport
@using BasicFinance.Web.Models
@{ ViewData["Title"] = "Import preview"; var valid = Model.Rows.Count(x => x.ValidationError is null && !x.IsDuplicate && !x.IsImported && !x.RequiresReview); var errors = Model.Rows.Count(x => x.ValidationError is not null); var duplicates = Model.Rows.Count(x => x.IsDuplicate); var review = Model.Rows.Count(x => x.RequiresReview && x.ValidationError is null); }
<section class="page-heading"><div><p class="eyebrow">IMPORT REVIEW</p><h1>@Model.FileName</h1><p class="page-description">@Model.Account.Name · @Model.Profile · Uploaded @Model.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p></div><a class="button button-secondary" asp-action="Index">Back to imports</a></section>
@if (Model.FriendlyAccountName is not null || Model.ExternalAccountNumberLast4 is not null)
{
    <div class="notice">Statement account: <strong>@(Model.FriendlyAccountName ?? Model.Account.Name)</strong> · Account ending in @(Model.ExternalAccountNumberLast4 ?? "unknown")</div>
}
<div class="summary-grid">
    <div class="summary-card"><span>Rows detected</span><strong>@Model.Rows.Count</strong></div>
    <div class="summary-card"><span>Ready to import</span><strong>@valid</strong></div>
    <div class="summary-card"><span>Duplicates</span><strong>@duplicates</strong></div>
    <div class="summary-card"><span>Errors</span><strong>@errors</strong></div>
    <div class="summary-card"><span>Needs review</span><strong>@review</strong></div>
</div>
@if (Model.Status == StatementImportStatus.Preview)
{
    <div class="notice">Review the rows below. Only valid, non-duplicate rows that do not require additional review will be posted after confirmation. This action cannot be undone from the import screen; individual ledger entries can be deleted later.</div>
}
else
{
    <div class="notice notice-success">Import status: @Model.Status. Completed @Model.CompletedUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt").</div>
}
<div class="table-card"><div class="table-scroll"><table>
    <thead><tr><th>CSV row</th><th>Date</th><th>Activity</th><th>Description</th><th>Symbol / CUSIP</th><th>Security type</th><th>Quantity</th><th>Price</th><th>Amount</th><th>Review status</th></tr></thead>
    <tbody>@foreach (var row in Model.Rows.OrderBy(x => x.RowNumber))
    {
        <tr><td>@row.RowNumber</td><td>@(row.TransactionDate?.ToString("MMM d, yyyy") ?? "—")
            @if (row.PostingDate is not null && row.PostingDate != row.TransactionDate) { <div class="table-subtext">Post: @row.PostingDate.Value.ToString("MMM d")</div> }
            @if (row.EffectiveDate is not null) { <div class="table-subtext">Effective: @row.EffectiveDate.Value.ToString("MMM d")</div> }
            @if (row.ProcessDate is not null) { <div class="table-subtext">Processed: @row.ProcessDate.Value.ToString("MMM d")</div> }
            @if (row.SettlementDate is not null) { <div class="table-subtext">Settled: @row.SettlementDate.Value.ToString("MMM d")</div> }
        </td><td>@(row.Activity ?? row.Type.ToString())</td><td>@row.Description<div class="table-subtext">@(row.Source ?? row.SourceType ?? "") · @(row.SourceSubType ?? row.TransactionCode ?? "")</div>
            <div class="table-subtext">@(row.FundName ?? row.Instrument ?? "") · @(row.SourceStatus ?? "")</div>
            @if (!string.IsNullOrWhiteSpace(row.SourceCategory)) { <div class="table-subtext">Source category: @row.SourceCategory</div> }
            @if (!string.IsNullOrWhiteSpace(row.Memo) || !string.IsNullOrWhiteSpace(row.ExtendedDescription)) { <div class="table-subtext">@(row.Memo ?? row.ExtendedDescription)</div> }</td><td>@(row.Symbol ?? "—")<div class="table-subtext">@(row.Cusip ?? "")</div></td><td>@(row.SecurityType ?? "—")</td><td>@(row.Quantity?.ToString("N6") ?? row.UnitCount?.ToString("N6") ?? "—")</td><td>@(row.Price?.ToString("N4") ?? row.UnitValue?.ToString("N6") ?? "—")</td><td>@(row.SourceSignedAmount?.ToString("N2") ?? row.Amount.ToString("N2")) @Model.Account.CurrencyCode</td>
        <td>@if (row.ValidationError is not null) { <span class="status-error">Error: @row.ValidationError</span> } else if (row.IsDuplicate) { <span class="status-warning">Duplicate — skipped</span> } else if (row.IsImported) { <span class="status-success">Imported</span> } else if (row.RequiresReview) {
            <span class="status-warning">Needs review — not posted</span>
            @if (Model.Profile == StatementImportProfile.RobinhoodBrokerage) {
                <form asp-action="ReviewRobinhoodRow" asp-route-id="@Model.Id" method="post" class="row-review-form">
                    <input type="hidden" name="rowId" value="@row.Id" />
                    <label class="visually-hidden" for="type-@row.Id">Map @row.TransactionCode to</label>
                    <select id="type-@row.Id" name="normalizedType">
                        <option value="Income">Income</option>
                        <option value="Expense">Expense</option>
                        <option value="Deposit">Deposit</option>
                        <option value="Withdrawal">Withdrawal</option>
                    </select>
                    <button type="submit" class="button button-secondary">Approve mapping</button>
                </form>
            }
        } else { <span class="status-ready">Ready</span> }</td></tr>
    }</tbody>
</table></div></div>
@if (Model.Status == StatementImportStatus.Preview)
{
    <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="form-actions confirm-import" onsubmit="return confirm('Import all valid, non-duplicate rows into the selected account?');">
        <button type="submit" class="button button-primary" disabled="@(valid == 0)">Confirm import (@valid rows)</button>
        <a class="button button-secondary" asp-action="Index">Cancel</a>
    </form>
}
